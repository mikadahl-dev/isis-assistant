# Copy to config.env (git-ignored) and adjust. Read by install-ct.sh / deploy.sh (Proxmox) and scripts/setup.sh.

# ---- Proxmox container (only install-ct.sh / deploy.sh) ----
CT_ID=108
CT_HOSTNAME=isis
CT_IP=192.168.1.50/24          # or "dhcp"
CT_GW=192.168.1.1
CT_DNS=192.168.1.1
CT_BRIDGE=vmbr0
CT_STORAGE=local-lvm
CT_DISK_GB=20
CT_CORES=4                     # jeff (llama.cpp) runs on these CPUs
CT_MEMORY_MB=4096
CT_TEMPLATE=local:vztmpl/debian-13-standard_13.6-1_amd64.tar.zst
# Host folder for files, isis.ics and the Obsidian vault, bind-mounted to /mnt/isis in the CT.
# Empty = everything stays inside the container's own disk.
DATA_HOST_DIR=

# ---- App (written once into /etc/isis/isis.env, edit that file later) ----
ISIS_URL=https://isis.tu-berlin.de        # any Moodle with the mobile app service enabled
ISIS_OLLAMA=http://127.0.0.1:11434        # Ollama with the model below, OLLAMA_CONTEXT_LENGTH>=8192
ISIS_MODEL=qwen3.5:9b
ISIS_API_ALLOW=127.0.0.1                  # comma list of IPs that may call isis-api (your dashboard host)
ISIS_UID=999                              # fixed uid of the service user (host ACL for DATA_HOST_DIR = 100000+uid)
WITH_JEFF=1                               # 0 = skip the jeff checker (no llama.cpp build, ~1 GB less)
