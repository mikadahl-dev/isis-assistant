[Unit]
Description=isis Wissensnetz (9B extraction via Ollama, optional jeff check) -> Obsidian vault
After=network-online.target jeff.service
Wants=network-online.target jeff.service

[Service]
Type=oneshot
User=isis
Group=isis
EnvironmentFile=/etc/isis/isis.env
WorkingDirectory=/opt/isis
ExecStart=/opt/isis/venv/bin/python -m app.isis.knowledge.build --quiet
TimeoutStartSec=4h
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
ReadWritePaths=/var/lib/isis -/mnt/isis
MemoryMax=768M
